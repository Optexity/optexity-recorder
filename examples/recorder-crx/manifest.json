{
  "name": "Optexity Recorder Nanonets",
  "version": "0.1.0",
  "manifest_version": 3,
  "icons": {
    "16": "Optexity_logo_16.png",
    "32": "Optexity_logo_32.png",
    "48": "Optexity_logo_48.png",
    "128": "Optexity_logo_128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "Optexity_logo_16.png",
      "32": "Optexity_logo_32.png"
    },
    "default_title": "Record"
  },
  "commands": {
    "record": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start recording"
    },
    "inspect": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Start inspecting"
    }
  },
  "side_panel": {
    "default_path": "empty.html"
  },
  "options_ui": {
    "page": "preferences.html",
    "open_in_tab": false
  },
  "permissions": ["debugger", "tabs", "contextMenus", "storage", "sidePanel"]
}
